---
interface Props {
  title: string;
  description: string;
  url: string;
}

const { title, description, url } = Astro.props;
---

<div class="share-bar" aria-label="分享这篇文章">
  <span class="share-label">分享</span>
  <div class="share-buttons">
    <button
      type="button"
      class="share-btn share-fb"
      data-platform="facebook"
      data-url={url}
      data-title={title}
      aria-label="分享到 Facebook"
      title="分享到 Facebook"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14 9h3V6h-3c-1.66 0-3 1.34-3 3v2H9v3h2v7h3v-7h2.5l.5-3h-3V9.5c0-.28.22-.5.5-.5z"/>
      </svg>
    </button>

    <button
      type="button"
      class="share-btn share-tw"
      data-platform="twitter"
      data-url={url}
      data-title={title}
      aria-label="分享到 Twitter"
      title="分享到 Twitter"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22 5.8c-.7.3-1.5.6-2.4.7.9-.5 1.5-1.3 1.8-2.3-.8.5-1.7.8-2.6 1-.8-.8-1.9-1.3-3.1-1.3-2.4 0-4.3 1.9-4.3 4.3 0 .3 0 .7.1 1C7.7 9 4.1 7.1 1.7 4.2c-.4.6-.6 1.3-.6 2.1 0 1.5.8 2.8 1.9 3.6-.7 0-1.4-.2-2-.5v.1c0 2.1 1.5 3.8 3.4 4.2-.4.1-.7.2-1.1.2-.3 0-.5 0-.8-.1.5 1.7 2.1 2.9 3.9 2.9-1.4 1.1-3.2 1.8-5.2 1.8H0c1.8 1.2 4 1.9 6.3 1.9 7.5 0 11.7-6.3 11.7-11.7v-.5c.8-.6 1.5-1.3 2-2.1z"/>
      </svg>
    </button>

    <button
      type="button"
      class="share-btn share-wc"
      data-platform="wechat"
      data-url={url}
      aria-label="分享到微信"
      title="分享到微信"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 4C5.1 4 2 6.7 2 10c0 1.9 1.1 3.6 2.7 4.7L4 17l2.5-1.3c.8.2 1.6.3 2.5.3.2 0 .5 0 .7-.1-.1-.4-.2-.8-.2-1.3 0-2.9 2.8-5.3 6.3-5.3.2 0 .5 0 .7.1C16 6.5 12.8 4 9 4zm-2.5 4c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1zm5 0c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1zM15.5 11c-3 0-5.5 2.1-5.5 4.7s2.4 4.7 5.5 4.7c.7 0 1.4-.1 2-.3L19 21l-.5-1.7c1.3-.9 2.2-2.4 2.2-4 0-2.6-2.4-4.7-5.2-4.7zm-1.7 3c.4 0 .7.3.7.7s-.3.7-.7.7-.7-.3-.7-.7.3-.7.7-.7zm3.5 0c.4 0 .7.3.7.7s-.3.7-.7.7-.7-.3-.7-.7.3-.7.7-.7z"/>
      </svg>
    </button>

    <button
      type="button"
      class="share-btn share-wb"
      data-platform="weibo"
      data-url={url}
      data-title={title}
      aria-label="分享到微博"
      title="分享到微博"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M10 8c-3.6 0-6.5 2.3-6.5 5.2 0 2.9 2.9 5.3 6.5 5.3s6.5-2.4 6.5-5.3c0-2.9-2.9-5.2-6.5-5.2zm-1.7 7.6c-1.5.1-2.9-.7-3-1.8-.2-1.1 1-2.1 2.5-2.3 1.5-.1 2.9.7 3 1.8.2 1.2-.9 2.2-2.5 2.3zm10.3-9.2c-.4-.4-1.1-.4-1.5 0-.4.4-.4 1 0 1.4.7.7.7 1.9 0 2.6-.4.4-.4 1 0 1.4.2.2.5.3.7.3s.5-.1.7-.3c1.6-1.5 1.6-4 0-5.4zm-2.1 2c-.3-.3-.7-.3-1 0-.3.3-.3.7 0 1 .4.4.4 1.1 0 1.5-.3.3-.3.7 0 1 .1.1.3.2.5.2s.4-.1.5-.2c1-1 .9-2.5-.1-3.5z"/>
      </svg>
    </button>

    <button
      type="button"
      class="share-btn share-qq"
      data-platform="qq"
      data-url={url}
      data-title={title}
      data-description={description}
      aria-label="分享给 QQ 好友"
      title="分享给 QQ 好友"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2c-3.9 0-7 2.8-7 6.3 0 2 .8 3.5 1.4 4.6-.2.4-.5 1-.8 1.3-.3.4-.6.8-.5 1.3.1.3.3.5.6.5.6.1 1.4-.2 2-.4.2.4.5.7.9.9-.6.3-1.3.7-1.6 1.1-.2.3-.1.6.2.7.5.2 1.5.3 2.6.3h.4c1.1 0 2.1-.1 2.6-.3.3-.1.4-.4.2-.7-.3-.4-1-.8-1.6-1.1.4-.2.7-.5.9-.9.6.2 1.4.5 2 .4.3 0 .5-.2.6-.5.1-.5-.2-.9-.5-1.3-.3-.3-.6-.9-.8-1.3.6-1.1 1.4-2.6 1.4-4.6C19 4.8 15.9 2 12 2zm-2.5 5c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1zm5 0c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1z"/>
      </svg>
    </button>
  </div>
</div>

<div id="shareToast" class="share-toast" role="status" aria-live="polite"></div>

<script>
  const toast = document.getElementById("shareToast");

  const showToast = (message: string) => {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add("is-visible");
    window.clearTimeout((showToast as any)._timer);
    (showToast as any)._timer = window.setTimeout(() => {
      toast.classList.remove("is-visible");
    }, 2200);
  };

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".share-btn"));

  buttons.forEach((btn) => {
    btn.addEventListener("click", async () => {
      const platform = btn.dataset.platform;
      const url = btn.dataset.url ?? window.location.href;
      const title = btn.dataset.title ?? document.title;
      const description = btn.dataset.description ?? "";

      switch (platform) {
        case "facebook":
          window.open(
            `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
            "_blank",
            "width=580,height=540"
          );
          break;

        case "twitter":
          window.open(
            `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
            "_blank",
            "width=580,height=540"
          );
          break;

        case "weibo":
          window.open(
            `https://service.weibo.com/share/share.php?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`,
            "_blank",
            "width=580,height=540"
          );
          break;

        case "qq":
          window.open(
            `https://connect.qq.com/widget/shareqq/index.html?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}&desc=${encodeURIComponent(description)}&summary=${encodeURIComponent(title)}`,
            "_blank",
            "width=780,height=560"
          );
          break;

        case "wechat": {
          try {
            await navigator.clipboard.writeText(url);
            showToast("链接已复制，请打开微信分享");
          } catch {
            // 回退方案：使用传统的 execCommand
            const ta = document.createElement("textarea");
            ta.value = url;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            try {
              document.execCommand("copy");
              showToast("链接已复制，请打开微信分享");
            } catch {
              showToast("复制失败，请手动复制链接");
            }
            document.body.removeChild(ta);
          }
          break;
        }
      }
    });
  });
</script>

<style>
  .share-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    background: var(--glass-strong);
    border: 1px solid var(--line-soft);
    border-radius: 16px;
    backdrop-filter: blur(12px);
  }

  .share-label {
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .share-buttons {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 2px solid transparent;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    padding: 0;
  }

  .share-btn svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .share-btn:hover {
    transform: translateY(-2px);
  }

  .share-btn:active {
    transform: translateY(0);
  }

  .share-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .share-fb {
    color: #1877f2;
    border-color: #1877f2;
  }
  .share-fb:hover {
    background: rgba(24, 119, 242, 0.12);
    box-shadow: 0 6px 18px rgba(24, 119, 242, 0.25);
  }

  .share-tw {
    color: #1da1f2;
    border-color: #1da1f2;
  }
  .share-tw:hover {
    background: rgba(29, 161, 242, 0.12);
    box-shadow: 0 6px 18px rgba(29, 161, 242, 0.25);
  }

  .share-wc {
    color: #07c160;
    border-color: #07c160;
  }
  .share-wc:hover {
    background: rgba(7, 193, 96, 0.12);
    box-shadow: 0 6px 18px rgba(7, 193, 96, 0.25);
  }

  .share-wb {
    color: #e6162d;
    border-color: #e6162d;
  }
  .share-wb:hover {
    background: rgba(230, 22, 45, 0.12);
    box-shadow: 0 6px 18px rgba(230, 22, 45, 0.25);
  }

  .share-qq {
    color: #12b7f5;
    border-color: #12b7f5;
  }
  .share-qq:hover {
    background: rgba(18, 183, 245, 0.12);
    box-shadow: 0 6px 18px rgba(18, 183, 245, 0.25);
  }

  .share-toast {
    position: fixed;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    padding: 0.75rem 1.5rem;
    background: rgba(11, 21, 43, 0.95);
    border: 1px solid var(--line-soft);
    border-radius: 12px;
    color: var(--text-1);
    font-size: 0.875rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 100;
  }

  .share-toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 480px) {
    .share-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>