---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import MotionReveal from "./motion/MotionReveal.vue";
import { getTrackMeta, inferTrack } from "../lib/taxonomy";
import { toShortSlug } from "../lib/shortSlug";

interface Props {
  post: CollectionEntry<"posts">;
  delay?: number;
}

const { post, delay = 0 } = Astro.props;
const dateText = post.data.date.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL;

const track = inferTrack(post);
const sectionLabel = getTrackMeta(track).label;

const topKeywordTags = post.data.tags.slice(0, 4);

// Tag colors live in global.css as .tag-pal-0 … .tag-pal-5 so that both
// themes can define readable text colors (inline styles can't be themed).
const hashTag = (tag: string) =>
  tag.split("").reduce((acc, char) => Math.imul(acc, 31) + char.charCodeAt(0), 7) >>> 0;

const tagPalClass = (tag: string) => `tag-pal-${hashTag(tag) % 6}`;

const coverThumb = post.data.cover
  ? await getImage({
      src: post.data.cover,
      width: 420,
      height: 260,
      fit: "cover",
      quality: 78,
      format: "webp",
    })
  : null;

---

<MotionReveal client:visible delay={delay}>
  <a
    href={`${base}/posts/${toShortSlug(post.slug)}/`}
    class="group block h-full rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)]"
  >
    <article
      class="glass-card flex h-full gap-4 overflow-hidden rounded-2xl p-4 transition duration-200 group-hover:-translate-y-1 group-hover:border-[var(--card-hover-border)]"
    >
      <!-- 左侧封面：与文字等高 -->
      <div class="w-36 md:w-52 shrink-0 overflow-hidden rounded-xl">
        {coverThumb ? (
          <img
            src={coverThumb.src}
            width={coverThumb.attributes.width}
            height={coverThumb.attributes.height}
            alt={`${post.data.title} 封面`}
            class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full items-end bg-[var(--card-fallback-bg)] p-3 text-xs text-[var(--card-fallback-text)]">
            {sectionLabel}
          </div>
        )}
      </div>

      <!-- 右侧内容 -->
      <div class="min-w-0 flex-1">
        <div class="flex items-center justify-between gap-3">
          <div class="flex min-w-0 items-center gap-2 overflow-hidden whitespace-nowrap">
            {topKeywordTags.length > 0 ? (
              topKeywordTags.map((tag) => (
                <span class={`tag-pill ${tagPalClass(tag)} shrink-0 rounded-full px-2 py-1 text-xs font-semibold`}>
                  {tag}
                </span>
              ))
            ) : (
              <span class="tag-pill tag-pal-1 shrink-0 rounded-full px-2 py-1 text-xs font-semibold">
                {sectionLabel}
              </span>
            )}
          </div>

          <p class="shrink-0 text-xs tracking-[0.06em] text-[var(--card-date)]">
            {dateText}
          </p>
        </div>

        <h3 class="mt-2 text-xl font-bold leading-snug text-[var(--card-title)]">
          {post.data.title}
        </h3>

        <p class="mt-2 text-sm leading-relaxed text-[var(--card-excerpt)] line-clamp-3">
          {post.data.excerpt}
        </p>

      </div>
    </article>
  </a>
</MotionReveal>