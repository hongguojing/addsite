---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import MotionReveal from "./motion/MotionReveal.vue";
import { getTrackMeta, inferTrack } from "../lib/taxonomy";
import { toShortSlug } from "../lib/shortSlug";

interface Props {
  post: CollectionEntry<"posts">;
  delay?: number;
}

const { post, delay = 0 } = Astro.props;
const dateText = post.data.date.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL;

const track = inferTrack(post);
const sectionLabel = getTrackMeta(track).label;

const topKeywordTags = post.data.tags.slice(0, 4);

const tagPalette = [
  { bg: "rgba(130, 164, 235, 0.22)", border: "rgba(130, 164, 235, 0.4)", text: "#d9e8ff" },
  { bg: "rgba(141, 190, 169, 0.2)", border: "rgba(141, 190, 169, 0.4)", text: "#dcf7ea" },
  { bg: "rgba(188, 160, 221, 0.22)", border: "rgba(188, 160, 221, 0.42)", text: "#f1e5ff" },
  { bg: "rgba(214, 172, 142, 0.2)", border: "rgba(214, 172, 142, 0.38)", text: "#ffeddc" },
  { bg: "rgba(139, 182, 203, 0.2)", border: "rgba(139, 182, 203, 0.4)", text: "#dff4ff" },
  { bg: "rgba(178, 173, 216, 0.22)", border: "rgba(178, 173, 216, 0.42)", text: "#ece9ff" },
] as const;

const hashTag = (tag: string) =>
  tag.split("").reduce((acc, char) => Math.imul(acc, 31) + char.charCodeAt(0), 7) >>> 0;

const getTagStyle = (tag: string) => {
  const palette = tagPalette[hashTag(tag) % tagPalette.length];
  return `background:${palette.bg};border-color:${palette.border};color:${palette.text};`;
};

const coverThumb = post.data.cover
  ? await getImage({
      src: post.data.cover,
      width: 420,
      height: 260,
      fit: "cover",
      quality: 78,
      format: "webp",
    })
  : null;

---

<MotionReveal client:visible delay={delay}>
  <a
    href={`${base}/posts/${toShortSlug(post.slug)}/`}
    class="group block h-full rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#b9a0ff]/80"
  >
    <article
      class="glass-card flex h-full gap-4 overflow-hidden rounded-2xl p-4 transition duration-200 group-hover:-translate-y-1 group-hover:border-[#b39dff]/45"
    >
      <!-- 左侧封面：与文字等高 -->
      <div class="w-36 md:w-52 shrink-0 overflow-hidden rounded-xl">
        {coverThumb ? (
          <img
            src={coverThumb.src}
            width={coverThumb.attributes.width}
            height={coverThumb.attributes.height}
            alt={`${post.data.title} 封面`}
            class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full items-end bg-[#1a2740] p-3 text-xs text-[#d5e1ff]">
            {sectionLabel}
          </div>
        )}
      </div>

      <!-- 右侧内容 -->
      <div class="min-w-0 flex-1">
        <div class="flex items-center justify-between gap-3">
          <div class="flex min-w-0 items-center gap-2 overflow-hidden whitespace-nowrap">
            {topKeywordTags.length > 0 ? (
              topKeywordTags.map((tag) => (
                <span class="shrink-0 rounded-full border px-2 py-1 text-xs font-semibold" style={getTagStyle(tag)}>
                  {tag}
                </span>
              ))
            ) : (
              <span class="rounded-full border border-[#70a8d5] bg-[#23618f]/32 px-2 py-1 text-xs font-semibold text-[#cde9ff]">
                {sectionLabel}
              </span>
            )}
          </div>

          <p class="shrink-0 text-xs tracking-[0.06em] text-[#8ea7d1]">
            {dateText}
          </p>
        </div>

        <h3 class="mt-2 text-xl font-bold leading-snug text-[#eef4ff]">
          {post.data.title}
        </h3>

        <p class="mt-2 text-sm leading-relaxed text-[#acc0e2] line-clamp-3">
          {post.data.excerpt}
        </p>

      </div>
    </article>
  </a>
</MotionReveal>