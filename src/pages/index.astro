---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import MotionReveal from "../components/motion/MotionReveal.vue";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = allPosts.slice(0, 5);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="ADHD 中文知识库 | 首页">
  <MotionReveal client:visible>
    <section class="hero-card">
      <p class="text-xs tracking-[0.2em] text-[#95aad0]">ADHD KNOWLEDGE LIBRARY</p>
      <h1 class="hero-title">理解自己，<br /><span class="accent-text">比定义自己更重要。</span></h1>
      <p class="hero-lead">一个关于 ADHD、执行功能与真实生活的长期知识档案。</p>

      <div class="chip-row">
        <span class="chip">科学</span>
        <span class="chip">循证</span>
        <span class="chip">可检索</span>
        <span class="chip">持续更新</span>
      </div>
    </section>
  </MotionReveal>

  <section class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
    <MotionReveal client:visible delay={0.05}>
      <a href={${base}science/} class="glass-card block rounded-2xl p-5 transition duration-200 hover:-translate-y-1 hover:border-[#b89fff]/40">
        <p class="text-xs tracking-[0.14em] text-[#9eb3d6]">认识 ADHD</p>
        <h2 class="mt-2 text-xl font-bold text-[#edf4ff]">机制、症状与误区</h2>
      </a>
    </MotionReveal>
    <MotionReveal client:visible delay={0.1}>
      <a href={${base}practice/} class="glass-card block rounded-2xl p-5 transition duration-200 hover:-translate-y-1 hover:border-[#b89fff]/40">
        <p class="text-xs tracking-[0.14em] text-[#9eb3d6]">评估与诊断</p>
        <h2 class="mt-2 text-xl font-bold text-[#edf4ff]">筛查、就医与报告解读</h2>
      </a>
    </MotionReveal>
    <MotionReveal client:visible delay={0.15}>
      <a href={${base}treatment/} class="glass-card block rounded-2xl p-5 transition duration-200 hover:-translate-y-1 hover:border-[#b89fff]/40">
        <p class="text-xs tracking-[0.14em] text-[#9eb3d6]">治疗</p>
        <h2 class="mt-2 text-xl font-bold text-[#edf4ff]">药物、干预与日常策略</h2>
      </a>
    </MotionReveal>
    <MotionReveal client:visible delay={0.2}>
      <a href={${base}life/} class="glass-card block rounded-2xl p-5 transition duration-200 hover:-translate-y-1 hover:border-[#b89fff]/40">
        <p class="text-xs tracking-[0.14em] text-[#9eb3d6]">生活</p>
        <h2 class="mt-2 text-xl font-bold text-[#edf4ff]">节奏、沟通与执行支持</h2>
      </a>
    </MotionReveal>
  </section>

  <section class="mt-5">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="section-title m-0">最新文章</h2>
      <a href={${base}posts/} class="text-sm text-[#b6ccf0] hover:text-[#deebff]">全部文章 →</a>
    </div>

    <div class="article-grid">
      {latest.map((post, index) => <PostCard post={post} delay={0.04 * index} />)}
    </div>
  </section>
</BaseLayout>
