---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toShortSlug } from "../../lib/shortSlug";
import { getTrackMeta, inferTrack } from "../../lib/taxonomy";

const base = import.meta.env.BASE_URL;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const slugAliasMap = Object.fromEntries(posts.map((post) => [post.slug, toShortSlug(post.slug)]));

const sectionLabelMap = {
  science: "认识 ADHD",
  practice: "评估与诊断",
  belike: "生活",
} as const;

// 新文章模板不再写 section，这里用 track 推出的栏目名兜底
const resolveSectionLabel = (post: CollectionEntry<"posts">) =>
  post.data.section ? sectionLabelMap[post.data.section] : getTrackMeta(inferTrack(post)).label;

const postMetaMap = Object.fromEntries(
  posts.map((post) => {
    const shortSlug = toShortSlug(post.slug);
    const date = post.data.date.toISOString().slice(0, 10);
    const section = resolveSectionLabel(post);
    return [shortSlug, { date, section }];
  }),
);

const localSearchDataset = posts.map((post) => {
  const shortSlug = toShortSlug(post.slug);
  const section = resolveSectionLabel(post);
  return {
    title: post.data.title,
    excerpt: post.data.excerpt,
    tags: post.data.tags,
    section,
    date: post.data.date.toISOString().slice(0, 10),
    url: `${base}/posts/${shortSlug}/`,
  };
});
---

<BaseLayout title="搜索 | ADHD 中文知识库">
  <section class="hero-card">
    <p class="text-xs tracking-[0.2em] text-[var(--hero-subtitle)]">SEARCH</p>
    <h1 class="hero-title mt-2">内容检索</h1>
    <p class="hero-lead">输入关键词，快速找到相关文章段落与主题。</p>
  </section>

  <section class="search-panel mt-4">
    <form id="searchForm" class="search-page-form" action={`${base}/search/`} method="get">
      <input id="searchInput" name="q" type="search" placeholder="例如：执行功能、诊断、药物、副作用" />
      <button type="submit">搜索</button>
    </form>

    <p id="searchState" class="search-state">正在等待输入...</p>
    <div id="searchResults" class="search-results"></div>
  </section>

  <script define:vars={{ base, slugAliasMap, postMetaMap, localSearchDataset }}>
    const stateEl = document.querySelector("#searchState");
    const resultsEl = document.querySelector("#searchResults");
    const inputEl = document.querySelector("#searchInput");
    const formEl = document.querySelector("#searchForm");

    const params = new URLSearchParams(window.location.search);
    const q = params.get("q")?.trim() ?? "";

    if (inputEl && q) {
      inputEl.value = q;
    }

    const setState = (text) => {
      if (stateEl) stateEl.textContent = text;
    };

    const escapeHtml = (value) =>
      value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");

    const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    const highlightText = (text, keyword) => {
      if (!keyword) return escapeHtml(text || "");
      const source = text || "";
      const regex = new RegExp(escapeRegExp(keyword), "ig");
      let lastIndex = 0;
      let html = "";

      source.replace(regex, (match, offset) => {
        html += escapeHtml(source.slice(lastIndex, offset));
        html += `<mark>${escapeHtml(match)}</mark>`;
        lastIndex = offset + match.length;
        return match;
      });

      html += escapeHtml(source.slice(lastIndex));
      return html;
    };

    const normalizeResult = (rawUrl) => {
      try {
        const resolved = new URL(rawUrl, window.location.origin);
        const match = resolved.pathname.match(/\/posts\/([^/]+)\/?$/);
        if (!match) {
          return {
            normalizedUrl: resolved.pathname + resolved.search + resolved.hash,
            shortSlug: null,
          };
        }

        const currentSlug = decodeURIComponent(match[1]);
        const shortSlug = slugAliasMap[currentSlug] ?? currentSlug;
        resolved.pathname = `${base}/posts/${shortSlug}/`;
        return {
          normalizedUrl: resolved.pathname + resolved.search + resolved.hash,
          shortSlug,
        };
      } catch {
        return {
          normalizedUrl: rawUrl,
          shortSlug: null,
        };
      }
    };

    const renderResults = (items, keyword) => {
      if (!resultsEl) return;
      if (items.length === 0) {
        resultsEl.innerHTML = "";
        setState("没有找到匹配内容。可以换个关键词试试。");
        return;
      }

      const uniqueItems = [];
      const seen = new Set();
      for (const item of items) {
        const { normalizedUrl, shortSlug } = normalizeResult(item.url);
        if (seen.has(normalizedUrl)) continue;
        seen.add(normalizedUrl);
        uniqueItems.push({ ...item, url: normalizedUrl, shortSlug });
      }

      setState(`找到 ${uniqueItems.length} 条结果`);
      resultsEl.innerHTML = uniqueItems
        .map((item) => {
          const meta = item.shortSlug ? postMetaMap[item.shortSlug] : null;
          const title = highlightText(item.meta.title || "未命名文章", keyword);
          const excerpt = highlightText(item.excerpt || "", keyword);
          const metaLine = meta
            ? `<div class="result-meta"><span>${escapeHtml(meta.section)}</span><span>${escapeHtml(meta.date)}</span></div>`
            : "";

          return `
            <a class="result-card" href="${item.url}">
              ${metaLine}
              <h3>${title}</h3>
              <p>${excerpt}</p>
            </a>
          `;
        })
        .join("");
    };

    const ensurePagefind = async () => {
      if (window.pagefind) return window.pagefind;

      await new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = `${base}/pagefind/pagefind.js`;
        script.async = true;
        script.onload = () => resolve(true);
        script.onerror = () => reject(new Error("load failed"));
        document.head.appendChild(script);
      });

      return window.pagefind;
    };

    const searchLocally = (keyword) => {
      const normalizedKeyword = keyword.toLowerCase();
      const results = localSearchDataset
        .map((item) => {
          const haystack = `${item.title} ${item.excerpt} ${item.tags.join(" ")} ${item.section}`.toLowerCase();
          const hitIndex = haystack.indexOf(normalizedKeyword);
          if (hitIndex === -1) return null;

          const score = item.title.toLowerCase().includes(normalizedKeyword)
            ? 3
            : item.tags.some((tag) => tag.toLowerCase().includes(normalizedKeyword))
              ? 2
              : 1;

          return {
            meta: { title: item.title },
            excerpt: item.excerpt,
            url: item.url,
            _score: score,
            _hitIndex: hitIndex,
          };
        })
        .filter(Boolean)
        .sort((a, b) => b._score - a._score || a._hitIndex - b._hitIndex)
        .slice(0, 20);

      return results;
    };

    const runSearch = async (keyword) => {
      if (!keyword) {
        setState("请输入关键词开始搜索。");
        if (resultsEl) resultsEl.innerHTML = "";
        return;
      }

      setState("正在检索，请稍候...");

      try {
        const pagefind = await ensurePagefind();
        if (!pagefind) throw new Error("no pagefind");
        const result = await pagefind.search(keyword, { excerptLength: 36 });
        const data = await Promise.all(result.results.slice(0, 20).map((item) => item.data()));
        renderResults(data, keyword);
      } catch (error) {
        const localResults = searchLocally(keyword);
        renderResults(localResults, keyword);
        setState(
          localResults.length > 0
            ? `找到 ${localResults.length} 条结果（本地模式）`
            : "没有找到匹配内容（本地模式）。可以换个关键词试试。",
        );
      }
    };

    if (q) {
      runSearch(q);
    }

    formEl?.addEventListener("submit", (event) => {
      event.preventDefault();
      const keyword = inputEl?.value.trim() ?? "";
      const next = new URL(window.location.href);
      if (keyword) {
        next.searchParams.set("q", keyword);
      } else {
        next.searchParams.delete("q");
      }
      history.replaceState(null, "", next.toString());
      runSearch(keyword);
    });
  </script>
</BaseLayout>
