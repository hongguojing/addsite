---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "ADHD 中文知识库：基于科学，面向真实生活" } = Astro.props;

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isActive = (target: string) => pathname === target || pathname.startsWith(`${target}/`);

const sideNav = [
  { href: base, label: "首页" },
  { href: `${base}/science/`, label: "认识 ADHD" },
  { href: `${base}/practice/`, label: "评估与诊断" },
  { href: `${base}/treatment/`, label: "治疗" },
  { href: `${base}/life/`, label: "生活" },
];
---

<!doctype html>
<html lang="zh-Hans" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Noto+Sans+SC:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Runs before first paint: default is dark, only an explicit saved
      // choice can switch it to light (system preference is ignored).
      (() => {
        try {
          const saved = localStorage.getItem("adhd-kb-theme");
          document.documentElement.setAttribute("data-theme", saved === "light" ? "light" : "dark");
        } catch {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <aside class="site-sidebar">
        <a href={base} class="brand-block" aria-label="ADHD 中文知识库首页">
          <span class="brand-icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" class="h-6 w-6" fill="none">
              <path d="M20 44c3-10 8-18 18-25" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              <path d="M45 17c2 5 2 10-1 14-4 5-10 9-20 14" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              <path d="M22 20c6-7 16-8 23-2 7 6 8 16 2 23" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
          </span>
          <div>
            <p class="brand-title">ADHD 中文知识库</p>
            <p class="brand-subtitle">基于科学 · 面向真实生活</p>
          </div>
        </a>

        <nav class="side-nav" aria-label="主导航">
          {sideNav.map((item) => (
            <a href={item.href} class={`side-link ${isActive(item.href) ? "side-link-active" : ""}`}>
              {item.label}
            </a>
          ))}
        </nav>
      </aside>

      <div class="site-main">
        <header class="top-toolbar">
          <form class="search-shell" action={`${base}/search/`} method="get">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
              <path d="M20 20l-3.6-3.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            <input id="siteSearch" type="text" name="q" placeholder="搜索文章、关键词、问题..." />
          </form>
          <div class="toolbar-actions">
            <div class="theme-switch" role="group" aria-label="主题切换">
              <button type="button" class="theme-toggle" data-theme-target="light" aria-label="切换到浅色主题" title="浅色主题">
                <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.7" />
                  <path
                    d="M12 2.7v2.1M12 19.2v2.1M4.6 12H2.5M21.5 12h-2.1M6.6 6.6 5.1 5.1M18.9 18.9l-1.5-1.5M17.4 6.6l1.5-1.5M5.1 18.9l1.5-1.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                  />
                </svg>
              </button>
              <button type="button" class="theme-toggle" data-theme-target="dark" aria-label="切换到深色主题" title="深色主题">
                <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M20.6 14.3A8.7 8.7 0 0 1 9.7 3.4 8.7 8.7 0 1 0 20.6 14.3Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>
          </div>
        </header>

        <main class="main-content">
          <slot />
        </main>

        <footer class="site-footer">
          <p>© 2026 ADHD 中文知识库</p>
        </footer>
      </div>
    </div>

    <script>
      (() => {
        const root = document.documentElement;
        const STORAGE_KEY = "adhd-kb-theme";

        // The initial attribute is set by the inline script in <head>.
        const syncButtons = () => {
          const current = root.getAttribute("data-theme") || "dark";
          document.querySelectorAll("[data-theme-target]").forEach((btn) => {
            const isActive = btn.getAttribute("data-theme-target") === current;
            btn.classList.toggle("is-active", isActive);
            btn.setAttribute("aria-pressed", String(isActive));
          });
        };

        document.querySelectorAll("[data-theme-target]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const target = btn.getAttribute("data-theme-target");
            root.setAttribute("data-theme", target);
            try {
              localStorage.setItem(STORAGE_KEY, target);
            } catch {
              /* storage unavailable — keep the in-page choice only */
            }
            syncButtons();
          });
        });

        syncButtons();
      })();
    </script>

    <script>
      // Hide the sticky toolbar while the reader scrolls down, bring it back
      // as soon as they scroll up. Never hide it while typing in the search box.
      (() => {
        const toolbar = document.querySelector(".top-toolbar");
        if (!toolbar) return;

        const searchInput = document.querySelector("#siteSearch");
        const HIDE_AFTER = 140;
        const DELTA = 6;

        let lastY = window.scrollY;
        let hidden = false;
        let ticking = false;

        const setHidden = (next) => {
          if (next === hidden) return;
          hidden = next;
          toolbar.classList.toggle("is-hidden", hidden);
          document.body.classList.toggle("toolbar-hidden", hidden);
        };

        const update = () => {
          ticking = false;
          const y = window.scrollY;
          const diff = y - lastY;

          if (Math.abs(diff) < DELTA) return;

          const isTyping = !!searchInput && document.activeElement === searchInput;

          if (y <= HIDE_AFTER || diff < 0 || isTyping) {
            setHidden(false);
          } else {
            setHidden(true);
          }

          lastY = y;
        };

        window.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );

        // Keep it visible whenever the search box is used
        searchInput?.addEventListener("focus", () => setHidden(false));
      })();
    </script>
  </body>
</html>
