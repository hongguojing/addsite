---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "ADHD 中文知识库：基于科学，面向真实生活" } = Astro.props;

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isActive = (target: string) => pathname === target || pathname.startsWith(`${target}/`);

const sideNav = [
  { href: base, label: "首页" },
  { href: `${base}/science/`, label: "认识 ADHD" },
  { href: `${base}/practice/`, label: "评估与诊断" },
  { href: `${base}/treatment/`, label: "治疗" },
  { href: `${base}/life/`, label: "生活" },
];
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Noto+Sans+SC:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="site-shell">
      <aside class="site-sidebar">
        <a href={base} class="brand-block" aria-label="ADHD 中文知识库首页">
          <span class="brand-icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" class="h-6 w-6" fill="none">
              <path d="M20 44c3-10 8-18 18-25" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              <path d="M45 17c2 5 2 10-1 14-4 5-10 9-20 14" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              <path d="M22 20c6-7 16-8 23-2 7 6 8 16 2 23" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
          </span>
          <div>
            <p class="brand-title">ADHD 中文知识库</p>
            <p class="brand-subtitle">基于科学 · 面向真实生活</p>
          </div>
        </a>

        <nav class="side-nav" aria-label="主导航">
          {sideNav.map((item) => (
            <a href={item.href} class={`side-link ${isActive(item.href) ? "side-link-active" : ""}`}>
              {item.label}
            </a>
          ))}
        </nav>
      </aside>

      <div class="site-main">
        <header class="top-toolbar">
          <form class="search-shell" action={`${base}/search/`} method="get">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
              <path d="M20 20l-3.6-3.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            <input id="siteSearch" type="text" name="q" placeholder="搜索文章、关键词、问题..." />
          </form>
          <div class="toolbar-actions">
            <button type="button" class="theme-toggle" data-theme-target="dark" aria-label="切换深色主题" title="深色主题">
              <span aria-hidden="true">☼</span>
            </button>
            <button type="button" class="theme-toggle" data-theme-target="light" aria-label="切换浅色主题" title="浅色主题">
              <span aria-hidden="true">◐</span>
            </button>
          </div>
        </header>

        <main class="main-content">
          <slot />
        </main>

        <footer class="site-footer">
          <p>© 2026 ADHD 中文知识库</p>
        </footer>
      </div>
    </div>

    <script>
      (() => {
        const root = document.documentElement;
        const STORAGE_KEY = "adhd-kb-theme";

        const saved = localStorage.getItem(STORAGE_KEY);
        const systemLight = window.matchMedia?.("(prefers-color-scheme: light)").matches;
        const initial = saved || (systemLight ? "light" : "dark");
        root.setAttribute("data-theme", initial);

        const syncButtons = () => {
          const current = root.getAttribute("data-theme") || "dark";
          document.querySelectorAll("[data-theme-target]").forEach((btn) => {
            btn.classList.toggle("is-active", btn.getAttribute("data-theme-target") === current);
          });
        };

        document.querySelectorAll("[data-theme-target]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const target = btn.getAttribute("data-theme-target");
            root.setAttribute("data-theme", target);
            localStorage.setItem(STORAGE_KEY, target);
            syncButtons();
          });
        });

        syncButtons();
      })();
    </script>

    <script>
      // Hide the sticky toolbar while the reader scrolls down, bring it back
      // as soon as they scroll up. Never hide it while typing in the search box.
      (() => {
        const toolbar = document.querySelector(".top-toolbar");
        if (!toolbar) return;

        const searchInput = document.querySelector("#siteSearch");
        const HIDE_AFTER = 140;
        const DELTA = 6;

        let lastY = window.scrollY;
        let hidden = false;
        let ticking = false;

        const setHidden = (next) => {
          if (next === hidden) return;
          hidden = next;
          toolbar.classList.toggle("is-hidden", hidden);
          document.body.classList.toggle("toolbar-hidden", hidden);
        };

        const update = () => {
          ticking = false;
          const y = window.scrollY;
          const diff = y - lastY;

          if (Math.abs(diff) < DELTA) return;

          const isTyping = !!searchInput && document.activeElement === searchInput;

          if (y <= HIDE_AFTER || diff < 0 || isTyping) {
            setHidden(false);
          } else {
            setHidden(true);
          }

          lastY = y;
        };

        window.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );

        // Keep it visible whenever the search box is used
        searchInput?.addEventListener("focus", () => setHidden(false));
      })();
    </script>
  </body>
</html>
